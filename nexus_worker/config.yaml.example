id: nexus-worker-standalone
name: Nexus Worker Standalone
host: 0.0.0.0
port: 8010
status: offline
enabled: true
# Optional control-plane request token reference. Leave disabled for a local-only node.
# request_token_env: NEXUS_WORKER_REQUEST_TOKEN
ollama_host: http://localhost:11434
capabilities:
  - type: llm
    provider: ollama
    models:
      - llama3.1:8b
tooling:
  cli_tools: []
  browser:
    enabled: false
    base_url: https://example.invalid
    allowed_paths:
      - /admin/*
    user_data_dir: /var/lib/nexus-worker/browser-profile
    request_token_env: NEXUS_BROWSER_WORKER_TOKEN
    headless: true
    timeout_seconds: 30000
  # The documentation tool is opt-in and can only create or compare-and-save
  # Markdown files under the explicitly allowed roots. Credentials stay in the
  # node environment and are never registered with the control plane.
  documentation_hub:
    enabled: false
    base_url: https://example.invalid
    username_env: GLOBEIQ_ADMIN_EMAIL
    password_env: GLOBEIQ_ADMIN_PASSWORD
    allowed_roots:
      - docs/Automation_Workforce
    max_content_bytes: 65536
    timeout_seconds: 20
metrics: {}
