id: nexus-worker-standalone
name: Nexus Worker Standalone
host: 0.0.0.0
port: 8010
status: offline
enabled: true
# Optional control-plane request token reference. Leave disabled for a local-only node.
# request_token_env: NEXUS_WORKER_REQUEST_TOKEN
ollama_host: http://localhost:11434
capabilities:
  - type: llm
    provider: ollama
    models:
      - llama3.1:8b
tooling:
  cli_tools: []
  browser:
    enabled: false
    base_url: https://example.invalid
    allowed_paths:
      - /admin/*
    user_data_dir: /var/lib/nexus-worker/browser-profile
    request_token_env: NEXUS_BROWSER_WORKER_TOKEN
    headless: true
    timeout_seconds: 30000
metrics: {}
